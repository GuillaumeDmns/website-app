<?xml version="1.0" encoding="utf-8"?>
<!-- 4 x 2 cells at first, resizable down to 2 x 2 (the small layout, NextDepartures) on every launcher:
     minResizeWidth/Height since Android 3.1, targetCell*, previewLayout and widgetFeatures read from Android 12
     (before, the picker shows the app's icon).
     Placing it opens the choice of its stop (WidgetConfigureActivity), reconfigurable later from the launcher (long
     press, "Modifier"). No periodic update of the system: NextDepartures draws it again as its departures leave, and
     WidgetRefreshWorker fetches them while the screen is on. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.guillaumedamiens.app.WidgetConfigureActivity"
    android:description="@string/app_widget_description"
    android:initialLayout="@layout/next_departures_choose"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/next_departures_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
