// The prod flavor (scheme "prod", configurations *-prod): the published app.
// Project-level base configuration (the widget extension reads it); the Runner's ones include it.
#include "Generated.xcconfig"

APP_BUNDLE_ID = com.guillaumedamiens.app
APP_DISPLAY_NAME = Nav'
// Shared with the widget extension (AppConfig.iosAppGroup on the Dart side)
APP_GROUP_ID = group.com.guillaumedamiens.app
// Reversed id of the flavor's Google iOS OAuth client (AppConfig.googleAppleClientId), the URL scheme Google returns
// through: com.googleusercontent.apps.<number>-<id>. A placeholder until that client exists.
GOOGLE_REVERSED_CLIENT_ID = com.guillaumedamiens.app.google-sign-in-unset
