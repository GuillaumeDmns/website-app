<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget extension's data (home_widget), "Terminer" on the Live Activity -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_ID)</string>
	</array>
	<!-- Links to the web app open the app (Universal Links, web/.well-known/apple-app-site-association) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.guillaumedamiens.com</string>
	</array>
</dict>
</plist>
